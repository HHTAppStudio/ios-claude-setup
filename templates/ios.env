# Cấu hình per-project cho plugin ios-toolkit — cài vào .claude/ios.env bằng /ios-init.
# Để trống SCHEME thì build.sh sẽ tự detect scheme đầu tiên.
SCHEME=""
# Workspace (.xcworkspace) ưu tiên hơn project (.xcodeproj). Để trống = tự detect.
WORKSPACE=""
PROJECT=""
# Device type để tạo simulator RIÊNG cho mỗi worktree khi chạy test
# (mỗi worktree một máy ảo → test song song không tranh nhau).
SIM_DEVICE="iPhone 16"
# Override destination thủ công (bỏ trống = khuyến nghị):
# - build mặc định dùng "generic/platform=iOS Simulator" (chỉ compile, không đụng simulator)
# - test mặc định dùng simulator riêng theo SIM_DEVICE ở trên
# Nếu đặt DESTINATION, cả build lẫn test dùng nó — tự chịu trách nhiệm tránh trùng
# simulator khi chạy nhiều worktree song song.
DESTINATION=""
# Nhánh chính để worktree rebase/merge về. Để trống = tự detect origin/HEAD, fallback main.
MAIN_BRANCH=""
# Có bắt buộc chạy test trước khi merge worktree không (1 = có).
MERGE_REQUIRE_TESTS=0
